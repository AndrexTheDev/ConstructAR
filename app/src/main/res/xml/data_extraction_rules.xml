<?xml version="1.0" encoding="utf-8"?>
<!-- Project files are the operator's measurements. They are excluded from cloud backup and
     device-to-device transfer: a measurement travels only when the operator exports it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
