<!-- The launcher icon: the themed badge on the app's ink, masked by the launcher.
     Denser launchers use the PNGs in mipmap-*dpi, which is also what API 24-25 sees. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/theme_ink" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
