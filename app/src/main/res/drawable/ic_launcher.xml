<!-- Launcher icon drawn as vectors (no binary assets in the repo): the Jamaica palette from
     Theme.kt - ink background, a yellow-green "cable run with a corner", gold anchor dots at the
     two ends (the two nodes an operator actually taps). Replace with a designed adaptive icon
     before a store release; this one exists so the app is recognisable on a home screen full of
     grey tool icons. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0C07" />
        </shape>
    </item>
    <item
        android:bottom="24dp"
        android:left="24dp"
        android:right="24dp"
        android:top="24dp">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="48"
            android:viewportHeight="48">
            <!-- Vertical drop, rounded corner, horizontal run -->
            <path
                android:fillColor="#00000000"
                android:pathData="M12,4 L12,28 Q12,36 20,36 L44,36"
                android:strokeColor="#C8F04A"
                android:strokeLineCap="round"
                android:strokeWidth="7" />
            <!-- Anchor dots -->
            <path
                android:fillColor="#FFD34D"
                android:pathData="M12,4 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />
            <path
                android:fillColor="#FFD34D"
                android:pathData="M44,36 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />
        </vector>
    </item>
</layer-list>
